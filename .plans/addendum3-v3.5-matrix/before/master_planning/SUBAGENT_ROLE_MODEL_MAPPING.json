{
  "schema": "subagent-role-model-mapping/v1",
  "status": "ASSIGNMENTS_VALIDATED",
  "assignment_owner": "USER",
  "selection_policy": {
    "primary_first": true,
    "scope": "every new lane, module, and launch",
    "rule": "Attempt the assigned primary on every new launch. Diagnose and exhaust viable in-scope repairs and retries for authentication, permissions, configuration, serialization, process, tooling, or task failures. Use the assigned fallback only when authoritative evidence establishes either (a) a provider compute or capacity limit, or (b) a genuinely external primary-route failure with no workable repair except switching agents. Never infer impossibility from silence, a single failure, inconvenience, or an unfamiliar error. A fallback applies only to that launch and never changes the next launch's primary selection; re-attempt the primary on every new lane, module, and launch."
  },
  "frozen_harness_routes": {
    "codex_native_lane": {
      "working_directory": "frozen-harness",
      "command": ["python", "-m", "orchestrator_harness.lane_controller", "{absolute_invocation_json}"],
      "binding_rule": "The invocation's codex_command array is prepended before the controller appends exec; model, model_reasoning_effort, and any invocation_binding.config_overrides are copied into the invocation. The controller appends every config_overrides value as a Codex -c override."
    },
    "external_headless_lane": {
      "working_directory": "frozen-harness",
      "command": ["python", "-m", "orchestrator_harness.operator_launch", "--receipt", "{absolute_receipt_json}", "--label", "{lane_label}", "--role", "controller", "--cwd", "{absolute_worktree}", "--"],
      "binding_rule": "This primitive starts an exact detached process and records its identity. It does not supply a native Claude lane controller or a canonical role resolver; ROOT must retain the provider-supervisor result and correlate it with the frozen receipt."
    }
  },
