64  + def _read(path: Path, limit: int, prior: dict[str, Any]) -> dict[str, Any]:
65  +     try:
66  +         st = path.stat()
67  +         fid = [st.st_dev, st.st_ino]
68  +         old = (
69  +             prior.get("offset", 0)
70  +             if prior.get("file_id") == fid and prior.get("offset", 0) <= st.st_size
71  +             else 0
72  +         )
73  +         offset = max(old, st.st_size - limit)
74  +         data = b""
75  +         if st.st_size > old or old == 0:
76  +             with path.open("rb") as h:
77  +                 h.seek(offset)
78  +                 data = h.read(limit)
79  +         changed = bool(data)
80  +         generation = (
81  +             hashlib.sha256(
82  +                 (
83  +                     str(fid)
84  +                     + ":"
85  +                     + str(st.st_size)
86  +                     + ":"
87  +                     + hashlib.sha256(data).hexdigest()
88  +                 ).encode()
89  +             ).hexdigest()
90  +             if changed
91  +             else prior.get("generation")
92  +         )
93  +         context = (
94  +             {
95  +                 "path": str(path),
96  +                 "sha256": hashlib.sha256(data).hexdigest(),
97  +                 "offset": offset,
98  +                 "text": data.decode("utf-8", "replace"),
99  +             }
100 +             if changed
101 +             else prior.get("context", {})
102 +         )
103 +         return {
104 +             "path": str(path),
105 +             **context,
106 +             "file_id": fid,
107 +             "size": st.st_size,
108 +             "changed": changed,
109 +             "generation": generation,
110 +         }
111 +     except OSError as e:
112 +         return {"path": str(path), "error": str(e), "changed": False}
