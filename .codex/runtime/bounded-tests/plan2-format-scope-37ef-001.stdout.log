571  +                 reversed_observation,
572  +             ],
573  +             epoch_id="epoch",
574  +             event_id="event",
575  +         )
576  +         self.assertEqual("INSUFFICIENT_EVIDENCE", report["classification"])
577  +         self.assertIsNone(report["metrics"]["publication_to_observation_seconds"])
