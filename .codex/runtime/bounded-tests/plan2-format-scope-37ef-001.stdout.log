540  +     def test_explicit_deferral_metric_requires_pre_pending_endpoint(self):
541  +         pending = rec("HARNESS_EVENT_PENDING", 10, response_deadline_utc=stamp(15))
542  +         deferred = rec("HARNESS_EVENT_DEFERRED", 4)
543  +         report = analyze_event([deferred, pending], epoch_id="epoch", event_id="event")
544  +         self.assertEqual(6.0, report["metrics"]["explicit_deferral_seconds"])
545  +
546  +         # A post-pending deferral is a later event, not a negative causal duration.
547  +         post_pending = rec("HARNESS_EVENT_DEFERRED", 11)
548  +         report = analyze_event(
549  +             [pending, post_pending], epoch_id="epoch", event_id="event"
550  +         )
551  +         self.assertIsNone(report["metrics"]["explicit_deferral_seconds"])
552  +         self.assertFalse(
553  +             any(
554  +                 "negative causal metric: explicit_deferral_seconds" in value
555  +                 for value in report["contradictory_evidence"]
