383  +                 recorder="h"
384  +                 if role == "harness"
385  +                 else "root"
386  +                 if role == "orchestrator"
387  +                 else "lane",
388  +                 epoch_id="epoch",
389  +                 event_id="event",
390  +                 kind=kind,
391  +                 source_timestamp_utc=stamp(t),
392  +                 metadata=metadata,
393  +             )
394  +             return canonicalize(
395  +                 source,
396  +                 observed_timestamp_utc=stamp(100 - t),
397  +                 source_path="source",
398  +                 source_role=role,
399  +                 source_id="h"
400  +                 if role == "harness"
401  +                 else "root"
402  +                 if role == "orchestrator"
403  +                 else "lane",
404  +                 source_generation="g",
405  +                 byte_start=0,
406  +                 byte_end=1,
407  +             )
408  +
409  +         common = {
410  +             "wake_id": wake,
411  +             "wake_component": "orchestrator_harness.watch_until_actionable",
412  +             "wake_transport": "blocking_harness_wait_stdout",
413  +             "manager_session_id": "s",
414  +             "manager_invocation_id": "i",
415  +         }
416  +         complete = [
417  +             item("AGENT_SIGNAL_CREATED", 0, lane_id="l", agent_blocked=True),
418  +             item("HARNESS_SIGNAL_OBSERVED", 1),
419  +             item("MANAGER_WAKE_ATTEMPTED", 2, **common),
420  +             item("MANAGER_WAKE_DELIVERED", 3, **common, delivery_succeeded=True),
421  +             item(
422  +                 "MANAGER_WAKE_RECEIVED",
423  +                 4,
424  +                 **{k: v for k, v in common.items() if k != "wake_component"},
425  +             ),
426  +             item(
427  +                 "MANAGER_WAIT_FINISHED",
428  +                 4,
429  +                 manager_session_id="s",
430  +                 manager_invocation_id="i",
431  +                 activity_id="w",
432  +                 wake_id=wake,
433  +                 wake_transport="blocking_harness_wait_stdout",
434  +             ),
435  +             item(
436  +                 "MANAGER_EVENT_CLAIMED",
437  +                 5,
438  +                 manager_session_id="s",
439  +                 manager_invocation_id="i",
440  +                 manager_state="READING_EVENT",
441  +             ),
442  +         ]
443  +         evidence = _wake_evidence(complete, event_id="event")
444  +         self.assertEqual("COMPLETE", evidence["status"])
445  +         self.assertEqual(1.0, evidence["attempted_to_delivered_seconds"])
446  +         self.assertEqual(1.0, evidence["delivered_to_received_seconds"])
447  +         self.assertEqual(1.0, evidence["received_to_claim_seconds"])
448  +         for index in range(len(complete)):
449  +             expected = "NOT_APPLICABLE" if index == 2 else "INSUFFICIENT_EVIDENCE"
450  +             self.assertEqual(
451  +                 expected,
452  +                 _wake_evidence(
453  +                     complete[:index] + complete[index + 1 :], event_id="event"
454  +                 )["status"],
455  +             )
456  +         duplicate = complete + [
457  +             item("MANAGER_WAKE_DELIVERED", 3, **common, delivery_succeeded=True)
458  +         ]
459  +         self.assertEqual(
460  +             "INSUFFICIENT_EVIDENCE",
461  +             _wake_evidence(duplicate, event_id="event")["status"],
462  +         )
463  +         reused = complete + [item("MANAGER_WAKE_ATTEMPTED", 2, **common)]
464  +         self.assertEqual(
465  +             "INSUFFICIENT_EVIDENCE", _wake_evidence(reused, event_id="event")["status"]
466  +         )
467  +         reordered = list(complete)
468  +         reordered[3] = item(
469  +             "MANAGER_WAKE_DELIVERED", 1, **common, delivery_succeeded=True
470  +         )
471  +         self.assertEqual(
472  +             "INSUFFICIENT_EVIDENCE",
473  +             _wake_evidence(reordered, event_id="event")["status"],
474  +         )
475  +         action = complete + [
476  +             item(
