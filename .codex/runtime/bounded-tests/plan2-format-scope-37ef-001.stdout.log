367  +
368  +         def item(kind, t, **metadata):
369  +             role = (
370  +                 "harness"
371  +                 if kind
372  +                 in {
373  +                     "HARNESS_SIGNAL_OBSERVED",
374  +                     "MANAGER_WAKE_ATTEMPTED",
375  +                     "MANAGER_WAKE_DELIVERED",
376  +                     "MANAGER_WAKE_FAILED",
377  +                 }
378  +                 else "orchestrator"
379  +                 if kind.startswith("MANAGER_")
380  +                 else "subagent"
381  +             )
