502  +             _wake_evidence(failed[1:], event_id="event")["status"],
503  +         )
504  +         failed_reordered = list(failed)
505  +         failed_reordered[1] = item("HARNESS_SIGNAL_OBSERVED", 3)
506  +         self.assertEqual(
