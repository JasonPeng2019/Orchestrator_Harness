478  +                 3.5,
479  +                 manager_session_id="s",
480  +                 manager_invocation_id="i",
481  +                 manager_state="READING_EVENT",
482  +             )
483  +         ]
484  +         self.assertEqual(
485  +             "INSUFFICIENT_EVIDENCE", _wake_evidence(action, event_id="event")["status"]
486  +         )
487  +         failed = [
488  +             item("AGENT_SIGNAL_CREATED", 0, lane_id="l", agent_blocked=True),
489  +             item("HARNESS_SIGNAL_OBSERVED", 1),
490  +             item("MANAGER_WAKE_ATTEMPTED", 2, **common),
491  +             item(
