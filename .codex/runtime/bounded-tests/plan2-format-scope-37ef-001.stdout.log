229 + def _attention_only_source(cfg: WatcherConfig, path: str) -> bool:
230 +     """Attention timelines are ingested separately and must not drive Terra reviews."""
231 +     return any(
232 +         str(source.path) == path
233 +         and source.role == "harness"
234 +         and source.path.name == "attention-events.jsonl"
235 +         for source in cfg.observed_sources
236 +     )
