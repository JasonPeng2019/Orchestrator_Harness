557  +         )
558  +
559  +         # The narrow metric repair must not suppress genuinely reversed causal stages.
560  +         reversed_signal = rec(
561  +             "AGENT_SIGNAL_CREATED", 12, lane_id="l", agent_blocked=True
562  +         )
