127 + def _route(cfg: WatcherConfig, item: dict[str, Any]) -> None:
128 +     if not item.get("changed") or "text" not in item:
129 +         return
130 +     role, source = _role(cfg, item["path"])
131 +     records = []
132 +     byte_cursor = item["offset"]
133 +     for line_number, raw_line in enumerate(item["text"].splitlines(keepends=True)):
134 +         raw_bytes = raw_line.encode("utf-8")
135 +         byte_start = byte_cursor
136 +         byte_cursor += len(raw_bytes)
137 +         byte_end = byte_cursor
138 +         line = raw_line.rstrip("\r\n")
139 +         if not line.strip():
140 +             continue
141 +         try:
142 +             record = json.loads(line)
143 +         except json.JSONDecodeError:
144 +             log(
145 +                 cfg.runtime_root,
146 +                 "watcher",
147 +                 "ROUTE_REJECTED",
148 +                 {
149 +                     "source_path": item["path"],
150 +                     "offset": item["offset"],
151 +                     "line": line_number,
152 +                     "byte_start": byte_start,
153 +                     "byte_end": byte_end,
154 +                     "reason": "malformed json record",
155 +                 },
156 +             )
157 +             continue
158 +         records.append((record, byte_start, byte_end, raw_bytes))
159 +     for record, byte_start, byte_end, raw_bytes in records:
160 +         if not isinstance(record, dict):
161 +             log(
162 +                 cfg.runtime_root,
163 +                 "watcher",
164 +                 "ROUTE_REJECTED",
165 +                 {"source_path": item["path"], "reason": "json record is not an object"},
166 +             )
167 +             continue
168 +         try:
169 +             if role == "supervisor":
170 +                 log(
171 +                     cfg.runtime_root,
172 +                     "orchestrator",
173 +                     "SUPERVISOR_ACTIVITY_INGESTED",
174 +                     {
175 +                         "source_path": item["path"],
176 +                         "offset": item["offset"],
177 +                         "records": [record],
178 +                     },
179 +                     source,
180 +                 )
181 +             elif role == "subagent":
182 +                 log(
183 +                     cfg.runtime_root,
184 +                     "subagents",
185 +                     "PROGRESS_INGESTED",
186 +                     {
187 +                         "source_path": item["path"],
188 +                         "offset": item["offset"],
189 +                         "record": record,
190 +                     },
191 +                     str(
192 +                         record.get("lane_id")
193 +                         or record.get("subagent_id")
194 +                         or record.get("doer")
195 +                         or source
196 +                     ),
197 +                 )
198 +             else:
199 +                 log(
200 +                     cfg.runtime_root,
201 +                     role,
202 +                     "ACTIVITY_INGESTED",
203 +                     {
204 +                         "source_path": item["path"],
205 +                         "offset": item["offset"],
206 +                         "records": [record],
207 +                     },
208 +                     source,
209 +                 )
210 +         except ValueError:
211 +             digest = hashlib.sha256(raw_bytes).hexdigest()
212 +             log(
213 +                 cfg.runtime_root,
214 +                 "watcher",
215 +                 "ROUTE_REJECTED",
216 +                 {
217 +                     "source_path": item["path"],
218 +                     "offset": item["offset"],
219 +                     "byte_start": byte_start,
220 +                     "byte_end": byte_end,
221 +                     "encoded_size": len(raw_bytes),
222 +                     "digest_scope": "raw_line_utf8",
223 +                     "reason": "record exceeds route limit",
224 +                     "sha256": digest,
225 +                 },
226 +             )
