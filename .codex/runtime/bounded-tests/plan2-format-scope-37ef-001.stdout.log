33  + def initialize_service_cursor(config: WatcherConfig) -> bool:
34  +     """Set a new background service epoch at the current EOF of existing sources."""
35  +     if _cursor_path(config.runtime_root).exists():
36  +         return False
37  +     now = time.time()
38  +     sources = {}
39  +     for path in config.observed_log_roots:
40  +         try:
41  +             st = path.stat()
42  +         except OSError:
43  +             continue
44  +         sources[str(path)] = {
45  +             "file_id": [st.st_dev, st.st_ino],
46  +             "offset": st.st_size,
47  +             "generation": None,
48  +             "context": {},
49  +             "last_changed_epoch": now,
50  +             "last_changed_utc": None,
51  +             "no_progress_evaluated_generation": None,
52  +         }
53  +     _save_cursor(
54  +         config.runtime_root,
55  +         {
56  +             "schema": "harness-watcher-cursor/v2",
57  +             "sources": sources,
58  +             "stale_quarantine": {},
59  +         },
60  +     )
61  +     return True
