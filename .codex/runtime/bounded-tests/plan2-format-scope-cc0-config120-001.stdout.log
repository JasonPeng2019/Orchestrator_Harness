368 + def poll(config: WatcherConfig, evaluator: Evaluator | None = None) -> dict[str, Any]:
369 +     if not settings.harness_watcher_active:
370 +         return {"disabled": True, "alert": None}
371 +     now = time.time()
372 +     attention = ingest_attention(config)
373 +     prior = _load_cursor(config.runtime_root)
374 +     previous = prior.get("sources", {})
375 +     quarantine = prior.get("stale_quarantine", {})
376 +     quarantine = quarantine if isinstance(quarantine, dict) else {}
377 +     items = []
378 +     loss, _identity = _primary_loss(config, prior)
379 +     primary_state = prior.get("primary_harness_loss")
380 +     if loss is not None:
381 +         fingerprint = hashlib.sha256(json.dumps(loss, sort_keys=True, default=str).encode()).hexdigest()
382 +         if not isinstance(primary_state, dict) or primary_state.get("fingerprint") != fingerprint:
383 +             log(
384 +                 config.runtime_root,
385 +                 "watcher",
386 +                 "PRIMARY_HARNESS_LOST",
387 +                 {**loss, "detection_utc": datetime.now(timezone.utc).isoformat()},
388 +             )
389 +         primary_state = {"fingerprint": fingerprint, "loss": loss}
390 +     else:
391 +         primary_state = None
392 +     for path in config.observed_log_roots:
393 +         item = _read(path, config.max_tail_bytes, previous.get(str(path), {}))
394 +         old = previous.get(str(path), {})
395 +         last = now if item.get("changed") else old.get("last_changed_epoch", now)
396 +         item["elapsed_since_change_seconds"] = max(0, now - last)
397 +         items.append(item)
398 +         _route(config, item)
399 +     evaluator_items = []
400 +     for item in items:
401 +         if _attention_only_source(config, item["path"]):
402 +             item["ordinary_evaluator_excluded"] = True
403 +             visible = dict(item)
404 +             visible["changed"] = False
405 +             visible["text"] = ""
406 +         else:
407 +             visible = _evaluator_item(item, quarantine, now)
408 +         evaluator_items.append(visible)
409 +     evaluator_items.extend(_matured_stale_observations(quarantine, now, config.poll_interval_seconds))
410 +     evaluate = any(x.get("changed") for x in evaluator_items)
411 +     for x, visible in zip(items, evaluator_items):
412 +         old = previous.get(x.get("path"), {})
413 +         x["no_progress_candidate"] = (
414 +             not x.get("ordinary_evaluator_excluded")
415 +             and not x.get("changed")
416 +             and x["elapsed_since_change_seconds"] >= config.no_progress_seconds
417 +             and old.get("no_progress_evaluated_generation") != x.get("generation")
418 +         )
419 +         visible["no_progress_candidate"] = x["no_progress_candidate"] and bool(visible.get("text", ""))
420 +         evaluate = evaluate or visible["no_progress_candidate"]
421 +     packet = {
422 +         "schema": "harness-watcher-review-packet/v1",
423 +         "packet_id": hashlib.sha256(json.dumps(evaluator_items, sort_keys=True).encode()).hexdigest(),
424 +         "created_utc": datetime.now(timezone.utc).isoformat(),
425 +         "elapsed_since_change_seconds": max((x["elapsed_since_change_seconds"] for x in items), default=0),
