100 + def _role(cfg: WatcherConfig, path: str) -> tuple[str, str]:
101 +     for source in cfg.observed_sources:
102 +         if str(source.path) == path and source.role:
103 +             return source.role, source.source_id
104 +     name = Path(path).name.lower()
105 +     if "manager" in name or "orchestr" in name:
106 +         return "orchestrator", "derived"
107 +     if "harness" in name or "event" in name:
108 +         return "harness", "derived"
109 +     return "subagent", "derived"
