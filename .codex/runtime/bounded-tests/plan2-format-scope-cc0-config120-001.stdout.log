1  + #!/usr/bin/env python3
2  + """Installed Codex PreToolUse hook enforcing the provider-owned bounded policy.
3  +
4  + The hook applies the same editable launcher/exclusion policy to every command
5  + launched inside this worktree.  It never decides, schedules, or supervises:
6  + it is a mechanical mistake guard that fails closed on invalid policy and lets
7  + the bounded supervisor own runtime deadlines.
8  + """
9  +
10 + from __future__ import annotations
11 +
12 + import json
13 + import sys
14 + from pathlib import Path
15 +
16 + from orchestrator_harness.codex_bounded_policy import guard_pre_tool_use
17 +
18 +
19 + def main() -> int:
20 +     raw = sys.stdin.read()
21 +     try:
22 +         payload = json.loads(raw) if raw.strip() else {}
23 +     except json.JSONDecodeError:
24 +         payload = {}
25 +     if not isinstance(payload, dict):
26 +         payload = {}
27 +     project_root = Path(__file__).resolve().parents[2]
28 +     result = guard_pre_tool_use(payload, policy_root=project_root)
29 +     sys.stdout.write(json.dumps(result, sort_keys=True) + "\n")
30 +     return 0
31 +
32 +
33 + if __name__ == "__main__":
34 +     raise SystemExit(main())
