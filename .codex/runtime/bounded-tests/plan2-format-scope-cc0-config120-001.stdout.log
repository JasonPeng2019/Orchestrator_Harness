443 +             "last_changed_epoch": now if x.get("changed") else old.get("last_changed_epoch", now),
444 +             "last_changed_utc": packet["created_utc"] if x.get("changed") else old.get("last_changed_utc"),
445 +             "no_progress_evaluated_generation": x.get("generation")
