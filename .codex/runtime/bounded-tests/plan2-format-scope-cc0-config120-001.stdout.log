205 + def _watcher_derived(record: object) -> bool:
206 +     return isinstance(record, dict) and (
207 +         record.get("type") == "HARNESS_WATCHER_ALERT"
208 +         or (isinstance(record.get("identity"), str) and record["identity"].startswith("harness-watcher:"))
209 +     )
210 +
211 +
212 + def _is_stale_recovery(record: object) -> bool:
213 +     if not isinstance(record, dict):
214 +         return False
215 +     if record.get("type") in {"CONTROLLER_ACTIVE", "CONTROLLER_EXITED"}:
216 +         return isinstance(record.get("identity"), str)
217 +     return (
218 +         record.get("type") == "CONDITION_CLEARED"
219 +         and isinstance(record.get("identity"), str)
220 +         and isinstance(record.get("data"), dict)
221 +         and record["data"].get("cleared_type") == "STALE_STATUS"
222 +     )
223 +
224 +
225 + def _quarantine_entry(item: dict[str, Any], record: dict[str, Any], now: float) -> dict[str, Any]:
226 +     """Keep the original evidence tuple: a later empty poll must still be citeable."""
227 +     return {
228 +         "identity": record["identity"],
229 +         "first_seen_epoch": now,
230 +         "record": record,
231 +         "evidence": {"path": item["path"], "sha256": item["sha256"], "offset": item["offset"]},
232 +         "released": False,
233 +     }
234 +
235 +
236 + def _evaluator_item(item: dict[str, Any], quarantine: dict[str, Any], now: float) -> dict[str, Any]:
237 +     """Hide watcher-derived records and quarantine new stale facts without rewriting raw state."""
238 +     visible = dict(item)
239 +     if "text" not in item:
240 +         return visible
241 +     lines = []
242 +     for line in item["text"].splitlines():
243 +         if not line.strip():
244 +             continue
245 +         try:
246 +             record = json.loads(line)
247 +         except json.JSONDecodeError:
248 +             record = None
249 +         if not isinstance(record, dict):
250 +             continue
251 +         if _watcher_derived(record):
252 +             continue
253 +         identity = record.get("identity")
254 +         if record.get("type") == "STALE_STATUS" and isinstance(identity, str):
255 +             if identity not in quarantine:
256 +                 quarantine[identity] = _quarantine_entry(item, record, now)
257 +             continue
258 +         if (
259 +             _is_stale_recovery(record)
260 +             and isinstance(identity, str)
261 +             and identity in quarantine
262 +             and not quarantine[identity].get("released")
263 +         ):
264 +             del quarantine[identity]
265 +             continue
266 +         lines.append(line)
267 +     visible["text"] = "\n".join(lines) + ("\n" if lines else "")
268 +     visible["changed"] = bool(item.get("changed")) and bool(lines)
269 +     return visible
