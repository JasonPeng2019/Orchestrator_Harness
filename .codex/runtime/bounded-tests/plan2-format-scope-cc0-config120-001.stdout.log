455 +             "primary_harness_loss": primary_state,
456 +         },
457 +     )
458 +     log(
459 +         config.runtime_root,
460 +         "watcher",
461 +         "POLL",
462 +         {
463 +             "packet_id": packet["packet_id"],
464 +             "sources": len(items),
465 +             "evaluated": evaluate,
466 +             "evaluator_enabled": config.evaluator_enabled,
467 +         },
468 +     )
