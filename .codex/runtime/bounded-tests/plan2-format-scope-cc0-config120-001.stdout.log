112 + def _route(cfg: WatcherConfig, item: dict[str, Any]) -> None:
113 +     if not item.get("changed") or "text" not in item:
114 +         return
115 +     role, source = _role(cfg, item["path"])
116 +     records = []
117 +     byte_cursor = item["offset"]
118 +     for line_number, raw_line in enumerate(item["text"].splitlines(keepends=True)):
119 +         raw_bytes = raw_line.encode("utf-8")
120 +         byte_start = byte_cursor
121 +         byte_cursor += len(raw_bytes)
122 +         byte_end = byte_cursor
123 +         line = raw_line.rstrip("\r\n")
124 +         if not line.strip():
125 +             continue
126 +         try:
127 +             record = json.loads(line)
128 +         except json.JSONDecodeError:
129 +             log(
130 +                 cfg.runtime_root,
131 +                 "watcher",
132 +                 "ROUTE_REJECTED",
133 +                 {
134 +                     "source_path": item["path"],
135 +                     "offset": item["offset"],
136 +                     "line": line_number,
137 +                     "byte_start": byte_start,
138 +                     "byte_end": byte_end,
139 +                     "reason": "malformed json record",
140 +                 },
141 +             )
142 +             continue
143 +         records.append((record, byte_start, byte_end, raw_bytes))
144 +     for record, byte_start, byte_end, raw_bytes in records:
145 +         if not isinstance(record, dict):
146 +             log(
147 +                 cfg.runtime_root,
148 +                 "watcher",
149 +                 "ROUTE_REJECTED",
150 +                 {"source_path": item["path"], "reason": "json record is not an object"},
151 +             )
152 +             continue
153 +         try:
154 +             if role == "supervisor":
155 +                 log(
156 +                     cfg.runtime_root,
157 +                     "orchestrator",
158 +                     "SUPERVISOR_ACTIVITY_INGESTED",
159 +                     {"source_path": item["path"], "offset": item["offset"], "records": [record]},
160 +                     source,
161 +                 )
162 +             elif role == "subagent":
163 +                 log(
164 +                     cfg.runtime_root,
165 +                     "subagents",
166 +                     "PROGRESS_INGESTED",
167 +                     {"source_path": item["path"], "offset": item["offset"], "record": record},
168 +                     str(record.get("lane_id") or record.get("subagent_id") or record.get("doer") or source),
169 +                 )
170 +             else:
171 +                 log(
172 +                     cfg.runtime_root,
173 +                     role,
174 +                     "ACTIVITY_INGESTED",
175 +                     {"source_path": item["path"], "offset": item["offset"], "records": [record]},
176 +                     source,
177 +                 )
178 +         except ValueError:
179 +             digest = hashlib.sha256(raw_bytes).hexdigest()
180 +             log(
181 +                 cfg.runtime_root,
182 +                 "watcher",
183 +                 "ROUTE_REJECTED",
184 +                 {
185 +                     "source_path": item["path"],
186 +                     "offset": item["offset"],
187 +                     "byte_start": byte_start,
188 +                     "byte_end": byte_end,
189 +                     "encoded_size": len(raw_bytes),
190 +                     "digest_scope": "raw_line_utf8",
191 +                     "reason": "record exceeds route limit",
192 +                     "sha256": digest,
193 +                 },
194 +             )
