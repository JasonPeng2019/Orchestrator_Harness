18  + def _load_cursor(root: Path) -> dict[str, Any]:
19  +     try:
20  +         return json.loads(_cursor_path(root).read_text(encoding="utf-8"))
21  +     except (OSError, json.JSONDecodeError):
22  +         return {"schema": "harness-watcher-cursor/v2", "sources": {}}
