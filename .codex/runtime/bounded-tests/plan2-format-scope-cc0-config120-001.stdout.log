197 + def _attention_only_source(cfg: WatcherConfig, path: str) -> bool:
198 +     """Attention timelines are ingested separately and must not drive Terra reviews."""
199 +     return any(
200 +         str(source.path) == path and source.role == "harness" and source.path.name == "attention-events.jsonl"
201 +         for source in cfg.observed_sources
202 +     )
