429  +     def test_explicit_deferral_metric_requires_pre_pending_endpoint(self):
430  +         pending = rec("HARNESS_EVENT_PENDING", 10, response_deadline_utc=stamp(15))
431  +         deferred = rec("HARNESS_EVENT_DEFERRED", 4)
432  +         report = analyze_event([deferred, pending], epoch_id="epoch", event_id="event")
433  +         self.assertEqual(6.0, report["metrics"]["explicit_deferral_seconds"])
434  +
435  +         # A post-pending deferral is a later event, not a negative causal duration.
436  +         post_pending = rec("HARNESS_EVENT_DEFERRED", 11)
437  +         report = analyze_event([pending, post_pending], epoch_id="epoch", event_id="event")
438  +         self.assertIsNone(report["metrics"]["explicit_deferral_seconds"])
439  +         self.assertFalse(
440  +             any(
441  +                 "negative causal metric: explicit_deferral_seconds" in value
442  +                 for value in report["contradictory_evidence"]
443  +             )
444  +         )
445  +
446  +         # The narrow metric repair must not suppress genuinely reversed causal stages.
447  +         reversed_signal = rec("AGENT_SIGNAL_CREATED", 12, lane_id="l", agent_blocked=True)
448  +         reversed_publication = published(reversed_signal, 12)
449  +         reversed_observation = rec("HARNESS_SIGNAL_OBSERVED", 11)
