272 + def _matured_stale_observations(
273 +     quarantine: dict[str, Any], now: float, poll_interval_seconds: int
274 + ) -> list[dict[str, Any]]:
275 +     """Release each unrecovered exact identity once, after one complete watcher interval."""
276 +     released = []
277 +     for identity, entry in quarantine.items():
278 +         if entry.get("released") or now - float(entry.get("first_seen_epoch", now)) < poll_interval_seconds:
279 +             continue
280 +         evidence = entry.get("evidence", {})
281 +         if not all(
282 +             isinstance(evidence.get(key), expected)
283 +             for key, expected in (("path", str), ("sha256", str), ("offset", int))
284 +         ):
285 +             continue
286 +         record = entry.get("record")
287 +         if not isinstance(record, dict):
288 +             continue
289 +         entry["released"] = True
290 +         released.append(
291 +             {
292 +                 "path": evidence["path"],
293 +                 "sha256": evidence["sha256"],
294 +                 "offset": evidence["offset"],
295 +                 "text": json.dumps(record, sort_keys=True) + "\n",
296 +                 "changed": True,
297 +                 "stale_status_quarantine_released": True,
298 +                 "quarantine_identity": identity,
299 +                 "quarantine_first_seen_epoch": entry["first_seen_epoch"],
300 +             }
301 +         )
302 +     return released
303 +
