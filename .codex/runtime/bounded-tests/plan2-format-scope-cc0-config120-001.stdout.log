305 + def _identity_time(value: object) -> datetime | None:
306 +     if not isinstance(value, str):
307 +         return None
308 +     try:
309 +         if value.startswith("windows-filetime:"):
310 +             return datetime(1601, 1, 1, tzinfo=timezone.utc) + timedelta(microseconds=int(value.split(":", 1)[1]) / 10)
311 +         return datetime.fromisoformat(value.replace("Z", "+00:00")).astimezone(timezone.utc)
312 +     except (ValueError, OverflowError):
313 +         return None
