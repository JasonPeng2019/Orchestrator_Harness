13  +
14  + def _load(root: Path) -> dict[str, Any]:
15  +     p = _path(root)
16  +     if not p.exists():
17  +         return {"schema": "harness-watcher-alerts/v1", "alerts": []}
18  +     raw = json.loads(p.read_text(encoding="utf-8"))
19  +     if raw.get("schema") != "harness-watcher-alerts/v1" or not isinstance(raw.get("alerts"), list):
20  +         raise ValueError("invalid alert state")
21  +     return raw
22  +
23  +
24  + def _save(root: Path, value: dict[str, Any]) -> None:
25  +     p = _path(root)
26  +     p.parent.mkdir(parents=True, exist_ok=True)
27  +     temp = p.with_suffix(".tmp")
28  +     temp.write_text(json.dumps(value, indent=2, sort_keys=True) + "\n", encoding="utf-8")
29  +     temp.replace(p)
30  +
31  +
32  + def save_alert(root: Path, verdict: Any, packet: dict[str, Any]) -> dict[str, Any] | None:
33  +     if not verdict.defect:
34  +         return None
35  +     signature = hashlib.sha256(
36  +         json.dumps(
37  +             {"kind": verdict.kind, "summary": verdict.summary, "evidence": verdict.evidence},
38  +             sort_keys=True,
39  +             default=list,
40  +         ).encode()
41  +     ).hexdigest()
42  +     state = _load(root)
43  +     for alert in state["alerts"]:
44  +         if alert["signature"] == signature and alert["recovery_state"] != "RESOLVED":
45  +             return alert
46  +     alert = {
47  +         "alert_id": "hwa-" + signature[:24],
48  +         "event_id": "hwa-" + signature,
49  +         "signature": signature,
50  +         "type": "HARNESS_WATCHER_ALERT",
51  +         "severity": verdict.severity,
52  +         "summary": verdict.summary,
53  +         "kind": verdict.kind,
54  +         "implicated": list(verdict.implicated),
55  +         "evidence": list(verdict.evidence),
56  +         "packet_id": packet["packet_id"],
57  +         "model": "gpt-5.6-terra",
58  +         "reasoning": "high",
59  +         "acknowledged": False,
60  +         "recovery_state": None,
61  +         "recovery_history": [],
62  +     }
63  +     state["alerts"].append(alert)
64  +     _save(root, state)
65  +     return alert
66  +
67  +
68  + def unresolved_alerts(repository_root: Path) -> list[dict[str, Any]]:
69  +     try:
70  +         state = _load(repository_root / "harness_watcher")
71  +     except (OSError, ValueError, json.JSONDecodeError):
72  +         return []
73  +     return [a for a in state["alerts"] if a.get("recovery_state") != "RESOLVED"]
74  +
75  +
76  + def acknowledge(root: Path, event_id: str) -> bool:
77  +     state = _load(root)
78  +     for a in state["alerts"]:
79  +         if a.get("event_id") == event_id:
80  +             a["acknowledged"] = True
81  +             _save(root, state)
82  +             return True
83  +     return False
84  +
85  +
