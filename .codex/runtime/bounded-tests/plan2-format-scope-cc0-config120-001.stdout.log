414  +     def test_causal_metrics_use_source_time_and_reject_negative_source_order(self):
415  +         signal = rec("AGENT_SIGNAL_CREATED", 0, lane_id="l", agent_blocked=True)
416  +         publication = published(signal, 1)
417  +         observed = rec("HARNESS_SIGNAL_OBSERVED", 2)
418  +         signal["observed_timestamp_utc"] = stamp(9)
419  +         publication["observed_timestamp_utc"] = stamp(8)
420  +         observed["observed_timestamp_utc"] = stamp(1)
421  +         report = analyze_event([signal, publication, observed], epoch_id="epoch", event_id="event")
422  +         self.assertEqual(1.0, report["metrics"]["signal_to_observation_seconds"])
423  +         self.assertEqual(1.0, report["metrics"]["creation_to_publication_seconds"])
424  +         self.assertFalse(any("negative causal metric" in value for value in report["contradictory_evidence"]))
425  +         inverted = rec("HARNESS_SIGNAL_OBSERVED", -1)
426  +         report = analyze_event([signal, publication, inverted], epoch_id="epoch", event_id="event")
427  +         self.assertEqual("INSUFFICIENT_EVIDENCE", report["classification"])
