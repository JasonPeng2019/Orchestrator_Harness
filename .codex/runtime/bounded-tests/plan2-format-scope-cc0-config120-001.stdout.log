316 + def _primary_loss(config: WatcherConfig, prior: dict[str, Any]) -> tuple[dict[str, Any] | None, dict[str, Any] | None]:
317 +     path = getattr(config, "primary_owner_identity_path", None)
318 +     if path is None:
319 +         return None, None
320 +     try:
321 +         identity = json.loads(path.read_text(encoding="utf-8"))
322 +     except (OSError, json.JSONDecodeError):
323 +         return {"reason": "identity-unreadable", "identity_path": str(path)}, None
324 +     if not isinstance(identity, dict):
325 +         return {"reason": "identity-invalid", "identity_path": str(path)}, None
326 +     if identity.get("exit_reason"):
327 +         return {
328 +             "reason": "primary-terminal",
329 +             "identity_path": str(path),
330 +             "exit_reason": identity.get("exit_reason"),
331 +         }, identity
332 +     expected = {key: identity.get(key) for key in ("owner", "managed_owner", "managed_watcher")}
333 +     if not all(
334 +         isinstance(v, dict) and isinstance(v.get("pid"), int) and _identity_time(v.get("created_utc")) is not None
335 +         for v in expected.values()
336 +     ):
337 +         return {"reason": "identity-incomplete", "identity_path": str(path), "expected": expected}, identity
338 +     from orchestrator_harness.processes import process_snapshot
339 +
340 +     snapshot = process_snapshot()
341 +     if not snapshot.complete:
342 +         return {"reason": "process-coverage-unknown", "identity_path": str(path), "expected": expected}, identity
343 +     live = {p.pid: p.created_utc for p in snapshot.processes}
344 +     valid = {key: value for key, value in expected.items() if isinstance(value, dict)}
345 +     mismatched = {
346 +         key: value
347 +         for key, value in valid.items()
348 +         if live.get(value["pid"]) is None or _identity_time(value["created_utc"]) != live[value["pid"]]
349 +     }
350 +     return (
351 +         (
352 +             {
353 +                 "reason": "identity-mismatch",
354 +                 "identity_path": str(path),
355 +                 "expected": expected,
356 +                 "observed": {
357 +                     str(pid): str(created) for pid, created in live.items() if pid in {v["pid"] for v in valid.values()}
358 +                 },
359 +                 "mismatched": mismatched,
360 +             },
361 +             identity,
362 +         )
363 +         if mismatched
364 +         else (None, identity)
365 +     )
