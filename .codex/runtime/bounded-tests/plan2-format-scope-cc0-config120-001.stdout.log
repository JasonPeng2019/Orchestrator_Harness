33  + def initialize_service_cursor(config: WatcherConfig) -> bool:
34  +     """Set a new background service epoch at the current EOF of existing sources."""
35  +     if _cursor_path(config.runtime_root).exists():
36  +         return False
37  +     now = time.time()
38  +     sources = {}
39  +     for path in config.observed_log_roots:
40  +         try:
41  +             st = path.stat()
42  +         except OSError:
43  +             continue
44  +         sources[str(path)] = {
45  +             "file_id": [st.st_dev, st.st_ino],
46  +             "offset": st.st_size,
47  +             "generation": None,
48  +             "context": {},
49  +             "last_changed_epoch": now,
50  +             "last_changed_utc": None,
51  +             "no_progress_evaluated_generation": None,
52  +         }
53  +     _save_cursor(
54  +         config.runtime_root, {"schema": "harness-watcher-cursor/v2", "sources": sources, "stale_quarantine": {}}
55  +     )
56  +     return True
57  +
58  +
59  + def _read(path: Path, limit: int, prior: dict[str, Any]) -> dict[str, Any]:
60  +     try:
61  +         st = path.stat()
62  +         fid = [st.st_dev, st.st_ino]
63  +         old = prior.get("offset", 0) if prior.get("file_id") == fid and prior.get("offset", 0) <= st.st_size else 0
64  +         offset = max(old, st.st_size - limit)
65  +         data = b""
66  +         if st.st_size > old or old == 0:
67  +             with path.open("rb") as h:
68  +                 h.seek(offset)
69  +                 data = h.read(limit)
70  +         changed = bool(data)
71  +         generation = (
72  +             hashlib.sha256(
73  +                 (str(fid) + ":" + str(st.st_size) + ":" + hashlib.sha256(data).hexdigest()).encode()
74  +             ).hexdigest()
75  +             if changed
76  +             else prior.get("generation")
77  +         )
78  +         context = (
79  +             {
80  +                 "path": str(path),
81  +                 "sha256": hashlib.sha256(data).hexdigest(),
82  +                 "offset": offset,
83  +                 "text": data.decode("utf-8", "replace"),
84  +             }
85  +             if changed
86  +             else prior.get("context", {})
87  +         )
88  +         return {
89  +             "path": str(path),
90  +             **context,
91  +             "file_id": fid,
92  +             "size": st.st_size,
93  +             "changed": changed,
94  +             "generation": generation,
95  +         }
96  +     except OSError as e:
97  +         return {"path": str(path), "error": str(e), "changed": False}
