25  + def _save_cursor(root: Path, v: dict[str, Any]) -> None:
26  +     p = _cursor_path(root)
27  +     p.parent.mkdir(parents=True, exist_ok=True)
28  +     t = p.with_suffix(".tmp")
29  +     t.write_text(json.dumps(v, sort_keys=True), encoding="utf-8")
