368 + def _primary_loss(
369 +     config: WatcherConfig, prior: dict[str, Any]
370 + ) -> tuple[dict[str, Any] | None, dict[str, Any] | None]:
371 +     path = getattr(config, "primary_owner_identity_path", None)
372 +     if path is None:
373 +         return None, None
374 +     try:
375 +         identity = json.loads(path.read_text(encoding="utf-8"))
376 +     except (OSError, json.JSONDecodeError):
377 +         return {"reason": "identity-unreadable", "identity_path": str(path)}, None
378 +     if not isinstance(identity, dict):
379 +         return {"reason": "identity-invalid", "identity_path": str(path)}, None
380 +     if identity.get("exit_reason"):
381 +         return {
382 +             "reason": "primary-terminal",
383 +             "identity_path": str(path),
384 +             "exit_reason": identity.get("exit_reason"),
385 +         }, identity
386 +     expected = {
387 +         key: identity.get(key) for key in ("owner", "managed_owner", "managed_watcher")
388 +     }
389 +     if not all(
390 +         isinstance(v, dict)
391 +         and isinstance(v.get("pid"), int)
392 +         and _identity_time(v.get("created_utc")) is not None
393 +         for v in expected.values()
394 +     ):
395 +         return {
396 +             "reason": "identity-incomplete",
397 +             "identity_path": str(path),
398 +             "expected": expected,
399 +         }, identity
400 +     from orchestrator_harness.processes import process_snapshot
401 +
402 +     snapshot = process_snapshot()
403 +     if not snapshot.complete:
404 +         return {
405 +             "reason": "process-coverage-unknown",
406 +             "identity_path": str(path),
407 +             "expected": expected,
408 +         }, identity
409 +     live = {p.pid: p.created_utc for p in snapshot.processes}
410 +     valid = {key: value for key, value in expected.items() if isinstance(value, dict)}
411 +     mismatched = {
412 +         key: value
413 +         for key, value in valid.items()
414 +         if live.get(value["pid"]) is None
415 +         or _identity_time(value["created_utc"]) != live[value["pid"]]
416 +     }
417 +     return (
418 +         (
419 +             {
420 +                 "reason": "identity-mismatch",
421 +                 "identity_path": str(path),
422 +                 "expected": expected,
423 +                 "observed": {
424 +                     str(pid): str(created)
425 +                     for pid, created in live.items()
426 +                     if pid in {v["pid"] for v in valid.values()}
427 +                 },
428 +                 "mismatched": mismatched,
429 +             },
430 +             identity,
431 +         )
432 +         if mismatched
433 +         else (None, identity)
434 +     )
