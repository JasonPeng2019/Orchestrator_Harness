317 + def _matured_stale_observations(
318 +     quarantine: dict[str, Any], now: float, poll_interval_seconds: int
319 + ) -> list[dict[str, Any]]:
320 +     """Release each unrecovered exact identity once, after one complete watcher interval."""
321 +     released = []
322 +     for identity, entry in quarantine.items():
323 +         if (
324 +             entry.get("released")
325 +             or now - float(entry.get("first_seen_epoch", now)) < poll_interval_seconds
326 +         ):
327 +             continue
328 +         evidence = entry.get("evidence", {})
329 +         if not all(
330 +             isinstance(evidence.get(key), expected)
331 +             for key, expected in (("path", str), ("sha256", str), ("offset", int))
332 +         ):
333 +             continue
334 +         record = entry.get("record")
335 +         if not isinstance(record, dict):
336 +             continue
337 +         entry["released"] = True
338 +         released.append(
339 +             {
340 +                 "path": evidence["path"],
341 +                 "sha256": evidence["sha256"],
342 +                 "offset": evidence["offset"],
343 +                 "text": json.dumps(record, sort_keys=True) + "\n",
344 +                 "changed": True,
345 +                 "stale_status_quarantine_released": True,
346 +                 "quarantine_identity": identity,
347 +                 "quarantine_first_seen_epoch": entry["first_seen_epoch"],
348 +             }
349 +         )
350 +     return released
