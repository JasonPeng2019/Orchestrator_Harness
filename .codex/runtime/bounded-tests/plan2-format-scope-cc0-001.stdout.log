115 + def _role(cfg: WatcherConfig, path: str) -> tuple[str, str]:
116 +     for source in cfg.observed_sources:
117 +         if str(source.path) == path and source.role:
118 +             return source.role, source.source_id
119 +     name = Path(path).name.lower()
120 +     if "manager" in name or "orchestr" in name:
121 +         return "orchestrator", "derived"
122 +     if "harness" in name or "event" in name:
123 +         return "harness", "derived"
124 +     return "subagent", "derived"
