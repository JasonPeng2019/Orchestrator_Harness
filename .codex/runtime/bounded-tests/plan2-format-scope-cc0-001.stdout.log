418  +             item("HARNESS_SIGNAL_OBSERVED", 1),
419  +             item("MANAGER_WAKE_ATTEMPTED", 2, **common),
420  +             item("MANAGER_WAKE_DELIVERED", 3, **common, delivery_succeeded=True),
421  +             item(
422  +                 "MANAGER_WAKE_RECEIVED",
423  +                 4,
424  +                 **{k: v for k, v in common.items() if k != "wake_component"},
425  +             ),
426  +             item(
