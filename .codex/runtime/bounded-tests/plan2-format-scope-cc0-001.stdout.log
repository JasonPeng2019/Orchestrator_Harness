239 + def _watcher_derived(record: object) -> bool:
240 +     return isinstance(record, dict) and (
241 +         record.get("type") == "HARNESS_WATCHER_ALERT"
242 +         or (
243 +             isinstance(record.get("identity"), str)
244 +             and record["identity"].startswith("harness-watcher:")
245 +         )
246 +     )
247 +
248 +
249 + def _is_stale_recovery(record: object) -> bool:
250 +     if not isinstance(record, dict):
251 +         return False
252 +     if record.get("type") in {"CONTROLLER_ACTIVE", "CONTROLLER_EXITED"}:
253 +         return isinstance(record.get("identity"), str)
254 +     return (
255 +         record.get("type") == "CONDITION_CLEARED"
256 +         and isinstance(record.get("identity"), str)
257 +         and isinstance(record.get("data"), dict)
258 +         and record["data"].get("cleared_type") == "STALE_STATUS"
259 +     )
