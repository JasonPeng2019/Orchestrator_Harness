353 + def _identity_time(value: object) -> datetime | None:
354 +     if not isinstance(value, str):
355 +         return None
356 +     try:
357 +         if value.startswith("windows-filetime:"):
358 +             return datetime(1601, 1, 1, tzinfo=timezone.utc) + timedelta(
359 +                 microseconds=int(value.split(":", 1)[1]) / 10
360 +             )
361 +         return datetime.fromisoformat(value.replace("Z", "+00:00")).astimezone(
362 +             timezone.utc
363 +         )
364 +     except (ValueError, OverflowError):
365 +         return None
