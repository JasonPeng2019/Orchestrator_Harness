437 + def poll(config: WatcherConfig, evaluator: Evaluator | None = None) -> dict[str, Any]:
438 +     if not settings.harness_watcher_active:
439 +         return {"disabled": True, "alert": None}
440 +     now = time.time()
441 +     attention = ingest_attention(config)
442 +     prior = _load_cursor(config.runtime_root)
443 +     previous = prior.get("sources", {})
444 +     quarantine = prior.get("stale_quarantine", {})
445 +     quarantine = quarantine if isinstance(quarantine, dict) else {}
446 +     items = []
447 +     loss, _identity = _primary_loss(config, prior)
448 +     primary_state = prior.get("primary_harness_loss")
449 +     if loss is not None:
450 +         fingerprint = hashlib.sha256(
451 +             json.dumps(loss, sort_keys=True, default=str).encode()
452 +         ).hexdigest()
453 +         if (
454 +             not isinstance(primary_state, dict)
455 +             or primary_state.get("fingerprint") != fingerprint
456 +         ):
457 +             log(
458 +                 config.runtime_root,
459 +                 "watcher",
460 +                 "PRIMARY_HARNESS_LOST",
461 +                 {**loss, "detection_utc": datetime.now(timezone.utc).isoformat()},
462 +             )
463 +         primary_state = {"fingerprint": fingerprint, "loss": loss}
464 +     else:
465 +         primary_state = None
466 +     for path in config.observed_log_roots:
467 +         item = _read(path, config.max_tail_bytes, previous.get(str(path), {}))
468 +         old = previous.get(str(path), {})
469 +         last = now if item.get("changed") else old.get("last_changed_epoch", now)
470 +         item["elapsed_since_change_seconds"] = max(0, now - last)
471 +         items.append(item)
472 +         _route(config, item)
473 +     evaluator_items = []
474 +     for item in items:
475 +         if _attention_only_source(config, item["path"]):
476 +             item["ordinary_evaluator_excluded"] = True
477 +             visible = dict(item)
478 +             visible["changed"] = False
479 +             visible["text"] = ""
480 +         else:
481 +             visible = _evaluator_item(item, quarantine, now)
482 +         evaluator_items.append(visible)
483 +     evaluator_items.extend(
484 +         _matured_stale_observations(quarantine, now, config.poll_interval_seconds)
485 +     )
486 +     evaluate = any(x.get("changed") for x in evaluator_items)
487 +     for x, visible in zip(items, evaluator_items):
488 +         old = previous.get(x.get("path"), {})
489 +         x["no_progress_candidate"] = (
490 +             not x.get("ordinary_evaluator_excluded")
491 +             and not x.get("changed")
492 +             and x["elapsed_since_change_seconds"] >= config.no_progress_seconds
493 +             and old.get("no_progress_evaluated_generation") != x.get("generation")
494 +         )
495 +         visible["no_progress_candidate"] = x["no_progress_candidate"] and bool(
496 +             visible.get("text", "")
497 +         )
498 +         evaluate = evaluate or visible["no_progress_candidate"]
499 +     packet = {
500 +         "schema": "harness-watcher-review-packet/v1",
501 +         "packet_id": hashlib.sha256(
502 +             json.dumps(evaluator_items, sort_keys=True).encode()
503 +         ).hexdigest(),
504 +         "created_utc": datetime.now(timezone.utc).isoformat(),
505 +         "elapsed_since_change_seconds": max(
506 +             (x["elapsed_since_change_seconds"] for x in items), default=0
507 +         ),
508 +         "observations": evaluator_items,
509 +         "attention_findings": attention.get("findings", []),
510 +         "constraints": {
511 +             "no_progress_seconds": config.no_progress_seconds,
512 +             "exclude": [
513 +                 "hardware/provider wait",
514 +                 "single retry",
515 +                 "firmware/server/test failure",
516 +             ],
517 +             "ownership_phase_rules": [dict(rule) for rule in OWNERSHIP_PHASE_RULES],
518 +             "stale_status_quarantine_rule": dict(STALE_STATUS_QUARANTINE_RULE),
519 +         },
520 +     }
521 +     saved = {}
522 +     for x in items:
523 +         old = previous.get(x.get("path"), {})
524 +         saved[x["path"]] = {
525 +             "file_id": x.get("file_id"),
526 +             "offset": x.get("size", 0),
527 +             "generation": x.get("generation"),
528 +             "context": {
529 +                 k: x[k] for k in ("path", "sha256", "offset", "text") if k in x
530 +             },
531 +             "last_changed_epoch": now
532 +             if x.get("changed")
533 +             else old.get("last_changed_epoch", now),
534 +             "last_changed_utc": packet["created_utc"]
535 +             if x.get("changed")
536 +             else old.get("last_changed_utc"),
537 +             "no_progress_evaluated_generation": x.get("generation")
538 +             if x.get("no_progress_candidate")
539 +             else (
540 +                 None
541 +                 if x.get("changed")
542 +                 else old.get("no_progress_evaluated_generation")
543 +             ),
544 +         }
545 +     _save_cursor(
546 +         config.runtime_root,
547 +         {
548 +             "schema": "harness-watcher-cursor/v2",
549 +             "sources": saved,
550 +             "stale_quarantine": quarantine,
551 +             "primary_harness_loss": primary_state,
552 +         },
553 +     )
554 +     log(
555 +         config.runtime_root,
556 +         "watcher",
557 +         "POLL",
558 +         {
559 +             "packet_id": packet["packet_id"],
560 +             "sources": len(items),
561 +             "evaluated": evaluate,
562 +             "evaluator_enabled": config.evaluator_enabled,
563 +         },
564 +     )
565 +     if not config.evaluator_enabled:
566 +         log(
567 +             config.runtime_root,
568 +             "watcher",
569 +             "EVALUATOR_SKIPPED",
570 +             {"packet_id": packet["packet_id"], "mode": "diagnostic-only"},
571 +         )
572 +         return {
573 +             "packet": packet,
574 +             "alert": None,
575 +             "skipped": True,
576 +             "mode": "diagnostic-only",
577 +             "primary_harness_loss": loss,
578 +         }
579 +     if not evaluate:
580 +         return {
581 +             "packet": packet,
582 +             "alert": None,
583 +             "skipped": True,
584 +             "primary_harness_loss": loss,
585 +         }
586 +     try:
587 +         if evaluator is None:
588 +             raise ValueError("evaluator is required when enabled")
589 +         verdict = evaluator.evaluate(packet)
590 +     except ValueError as exc:
