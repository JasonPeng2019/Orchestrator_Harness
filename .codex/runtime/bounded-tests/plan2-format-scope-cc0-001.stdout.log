262 + def _quarantine_entry(
263 +     item: dict[str, Any], record: dict[str, Any], now: float
264 + ) -> dict[str, Any]:
265 +     """Keep the original evidence tuple: a later empty poll must still be citeable."""
266 +     return {
267 +         "identity": record["identity"],
268 +         "first_seen_epoch": now,
269 +         "record": record,
270 +         "evidence": {
271 +             "path": item["path"],
272 +             "sha256": item["sha256"],
273 +             "offset": item["offset"],
274 +         },
275 +         "released": False,
276 +     }
277 +
278 +
279 + def _evaluator_item(
280 +     item: dict[str, Any], quarantine: dict[str, Any], now: float
281 + ) -> dict[str, Any]:
282 +     """Hide watcher-derived records and quarantine new stale facts without rewriting raw state."""
283 +     visible = dict(item)
284 +     if "text" not in item:
285 +         return visible
286 +     lines = []
287 +     for line in item["text"].splitlines():
288 +         if not line.strip():
289 +             continue
290 +         try:
291 +             record = json.loads(line)
292 +         except json.JSONDecodeError:
293 +             record = None
294 +         if not isinstance(record, dict):
295 +             continue
296 +         if _watcher_derived(record):
297 +             continue
298 +         identity = record.get("identity")
299 +         if record.get("type") == "STALE_STATUS" and isinstance(identity, str):
300 +             if identity not in quarantine:
301 +                 quarantine[identity] = _quarantine_entry(item, record, now)
302 +             continue
303 +         if (
304 +             _is_stale_recovery(record)
305 +             and isinstance(identity, str)
306 +             and identity in quarantine
307 +             and not quarantine[identity].get("released")
308 +         ):
309 +             del quarantine[identity]
310 +             continue
311 +         lines.append(line)
312 +     visible["text"] = "\n".join(lines) + ("\n" if lines else "")
313 +     visible["changed"] = bool(item.get("changed")) and bool(lines)
314 +     return visible
