17  + def _path(root: Path) -> Path:
18  +     return root / "watcher" / "alerts.json"
19  +
20  +
21  + def _load(root: Path) -> dict[str, Any]:
22  +     p = _path(root)
23  +     if not p.exists():
24  +         return {"schema": "harness-watcher-alerts/v1", "alerts": []}
25  +     raw = json.loads(p.read_text(encoding="utf-8"))
26  +     if raw.get("schema") != "harness-watcher-alerts/v1" or not isinstance(
27  +         raw.get("alerts"), list
28  +     ):
29  +         raise ValueError("invalid alert state")
30  +     return raw
31  +
32  +
33  + def _save(root: Path, value: dict[str, Any]) -> None:
34  +     p = _path(root)
35  +     p.parent.mkdir(parents=True, exist_ok=True)
36  +     temp = p.with_suffix(".tmp")
37  +     temp.write_text(
38  +         json.dumps(value, indent=2, sort_keys=True) + "\n", encoding="utf-8"
39  +     )
40  +     temp.replace(p)
41  +
42  +
43  + def save_alert(
44  +     root: Path, verdict: Any, packet: dict[str, Any]
45  + ) -> dict[str, Any] | None:
46  +     if not verdict.defect:
47  +         return None
48  +     signature = hashlib.sha256(
49  +         json.dumps(
50  +             {
51  +                 "kind": verdict.kind,
52  +                 "summary": verdict.summary,
53  +                 "evidence": verdict.evidence,
54  +             },
55  +             sort_keys=True,
56  +             default=list,
57  +         ).encode()
58  +     ).hexdigest()
59  +     state = _load(root)
60  +     for alert in state["alerts"]:
61  +         if alert["signature"] == signature and alert["recovery_state"] != "RESOLVED":
62  +             return alert
63  +     alert = {
64  +         "alert_id": "hwa-" + signature[:24],
65  +         "event_id": "hwa-" + signature,
66  +         "signature": signature,
67  +         "type": "HARNESS_WATCHER_ALERT",
68  +         "severity": verdict.severity,
69  +         "summary": verdict.summary,
70  +         "kind": verdict.kind,
71  +         "implicated": list(verdict.implicated),
72  +         "evidence": list(verdict.evidence),
73  +         "packet_id": packet["packet_id"],
74  +         "model": "gpt-5.6-terra",
75  +         "reasoning": "high",
76  +         "acknowledged": False,
77  +         "recovery_state": None,
78  +         "recovery_history": [],
79  +     }
80  +     state["alerts"].append(alert)
81  +     _save(root, state)
82  +     return alert
83  +
84  +
85  + def unresolved_alerts(repository_root: Path) -> list[dict[str, Any]]:
86  +     try:
87  +         state = _load(repository_root / "harness_watcher")
88  +     except (OSError, ValueError, json.JSONDecodeError):
89  +         return []
90  +     return [a for a in state["alerts"] if a.get("recovery_state") != "RESOLVED"]
91  +
92  +
93  + def acknowledge(root: Path, event_id: str) -> bool:
94  +     state = _load(root)
95  +     for a in state["alerts"]:
96  +         if a.get("event_id") == event_id:
97  +             a["acknowledged"] = True
98  +             _save(root, state)
99  +             return True
100 +     return False
101 +
102 +
103 + def transition(root: Path, alert_id: str, state_name: str) -> dict[str, Any]:
104 +     if state_name not in ORDER:
105 +         raise ValueError("unknown recovery state")
106 +     state = _load(root)
107 +     for a in state["alerts"]:
108 +         if a["alert_id"] == alert_id:
109 +             expected = (
110 +                 ORDER[0]
111 +                 if a["recovery_state"] is None
112 +                 else ORDER[ORDER.index(a["recovery_state"]) + 1]
113 +                 if a["recovery_state"] != ORDER[-1]
114 +                 else None
115 +             )
116 +             if expected != state_name:
117 +                 raise ValueError("recovery transition out of order")
118 +             a["recovery_state"] = state_name
119 +             a["recovery_history"].append(
120 +                 {"state": state_name, "at_utc": datetime.now(timezone.utc).isoformat()}
121 +             )
122 +             _save(root, state)
123 +             return a
124 +     raise ValueError("unknown alert")
