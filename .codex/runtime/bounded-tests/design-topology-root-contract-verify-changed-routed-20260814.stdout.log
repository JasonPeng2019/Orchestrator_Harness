1026 + def run_self_test() -> list[str]:
1027 +     plan = build_self_test_plan()
1028 +     failures: list[str] = []
1029 +     if errors := validate(plan, {"orchestrator"}, "mapping.json"):
1030 +         failures.append("valid fixture failed: " + "; ".join(errors))
1031 +
1032 +     corruptions = {
