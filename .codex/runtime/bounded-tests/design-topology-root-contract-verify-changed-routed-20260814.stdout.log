797  + def markdown_table(header: tuple[str, ...], rows: list[list[str]]) -> str:
798  +     lines = [
799  +         "| " + " | ".join(header) + " |",
800  +         "|" + "|".join("---" for _ in header) + "|",
801  +     ]
802  +     lines.extend("| " + " | ".join(row) + " |" for row in rows)
803  +     return "\n".join(lines)
