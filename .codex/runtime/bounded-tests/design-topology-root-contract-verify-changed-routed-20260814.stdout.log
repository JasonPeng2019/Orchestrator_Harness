488  + def validate_instances(body: str, instance_types: dict[str, str]) -> list[str]:
489  +     errors: list[str] = []
490  +     matches = list(INSTANCE_RE.finditer(body))
491  +     found_ids = [match.group(1) for match in matches]
492  +     if duplicates(found_ids):
493  +         errors.append(f"Section 11 contains duplicate module blocks: {', '.join(duplicates(found_ids))}")
494  +     missing = sorted(set(instance_types) - set(found_ids))
495  +     extra = sorted(set(found_ids) - set(instance_types))
496  +     if missing:
497  +         errors.append(f"selected module instances missing from Section 11: {', '.join(missing)}")
498  +     if extra:
499  +         errors.append(f"Section 11 has undeclared module instances: {', '.join(extra)}")
500  +
501  +     for index, match in enumerate(matches):
502  +         instance_id, module_type = match.group(1), match.group(2)
503  +         block_end = matches[index + 1].start() if index + 1 < len(matches) else len(body)
504  +         block = body[match.end() : block_end]
505  +         if instance_types.get(instance_id) != module_type:
506  +             errors.append(
507  +                 f"{instance_id} block type {module_type} does not match manifest type "
508  +                 f"{instance_types.get(instance_id, 'UNDECLARED')}"
509  +             )
510  +         fields = re.findall(r"(?m)^####\s+(.+?)\s*$", block)
511  +         if fields != INSTANCE_FIELDS:
512  +             errors.append(f"{instance_id} does not use the exact 15 subheadings in order")
513  +         local_start = block.find("#### Local instructions")
514  +         local_end = block.find("#### Outputs and results", local_start + 1)
515  +         local_body = block[local_start:local_end] if local_start >= 0 and local_end >= 0 else ""
516  +         task_rows = extract_table(local_body, ("Field", "Value"))
517  +         if task_rows is None:
518  +             errors.append(f"{instance_id} has no local task-card Field | Value table")
519  +         else:
520  +             valid_task_rows = [row for row in task_rows if len(row) == 2]
521  +             if [row[0] for row in valid_task_rows] != TASK_FIELDS:
522  +                 errors.append(f"{instance_id} does not use all 20 local task-card fields in order")
523  +             task_values = {row[0]: row[1] for row in valid_task_rows}
524  +             for task_field in TASK_FIELDS:
525  +                 task_value = normalize(task_values.get(task_field, "")).upper()
526  +                 if task_value in UNDISPATCHABLE_BARE_TASK_VALUES:
527  +                     errors.append(
528  +                         f"{instance_id} task field {task_field} has a bare placeholder; "
529  +                         "ROOT must supply a concrete dispatch-contract value or a reasoned N/A "
530  +                         "explicitly permitted by the selected recipe"
531  +                     )
532  +             found_actions = re.findall(r"\bM\d{2}-A\d+\b", task_values.get("ordered_actions", ""))
533  +             if found_actions != MODULE_ACTIONS.get(module_type, []):
534  +                 errors.append(
535  +                     f"{instance_id} ordered_actions must contain "
536  +                     f"{', '.join(MODULE_ACTIONS.get(module_type, []))} exactly once and in order"
537  +                 )
538  +     return errors
