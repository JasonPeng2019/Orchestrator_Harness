561  + def validate_gates(body: str) -> list[str]:
562  +     errors: list[str] = []
563  +     header = REQUIRED_TABLES[HEADINGS[8]][3]
564  +     rows = extract_table(body, header) or []
565  +     gate_ids = [row[0] for row in rows if len(row) == len(header) and row[0] != "N/A"]
566  +     if duplicates(gate_ids):
567  +         errors.append(f"gate manifest contains duplicates: {', '.join(duplicates(gate_ids))}")
568  +
569  +     for row in rows:
570  +         if len(row) != len(header) or row[0] == "N/A":
571  +             continue
572  +         gate_id, gate_class = row[0], row[1]
573  +         if not gate_id.startswith("GATE-"):
574  +             errors.append(f"gate row has invalid ID {gate_id!r}")
575  +         if gate_class not in ALLOWED_GATE_CLASSES:
576  +             errors.append(f"{gate_id} has invalid gate class {gate_class!r}")
577  +         required_fields = (
578  +             (6, "blocking scope"),
579  +             (7, "continuation/loop eligibility"),
580  +             (8, "default-forward edge"),
581  +             (9, "failure return target"),
582  +         )
583  +         for index, label in required_fields:
584  +             if row[index].lower() in {"", "n/a", "none", "not applicable"}:
585  +                 errors.append(f"{gate_id} has no {label}")
586  +         blocking_scope = row[6].lower()
587  +         continuation = row[7].lower()
588  +         default_forward = row[8].lower()
589  +         failure_target = row[9].lower()
590  +
591  +         if not any(
592  +             token in default_forward
593  +             for token in (
594  +                 "edge",
595  +                 "advance",
596  +                 "continue",
597  +                 "accept",
598  +                 "success",
599  +                 "terminal",
600  +             )
601  +         ):
602  +             errors.append(f"{gate_id} default-forward edge must name an advancing successor or terminal action")
603  +
604  +         if gate_class == "PRODUCT":
605  +             decided_outcome = row[3].lower()
606  +             strong_product_terms = (
607  +                 "behavior",
608  +                 "contract",
609  +                 "satisf",
610  +                 "capability",
611  +                 "agree",
612  +                 "prove",
613  +             )
614  +             operation_terms = (
615  +                 "allocat",
616  +                 "integrat",
617  +                 "join",
618  +                 "deploy",
619  +                 "promot",
620  +                 "read back",
621  +                 "readback",
622  +                 "cleanup",
623  +                 "retire",
624  +             )
625  +             names_product_outcome = any(token in decided_outcome for token in strong_product_terms) or (
626  +                 "correct" in decided_outcome and not any(token in decided_outcome for token in operation_terms)
627  +             )
628  +             if not names_product_outcome:
629  +                 errors.append(
630  +                     f"{gate_id} PRODUCT decided outcome must name observable behavior, "
631  +                     "contract, capability, correctness, satisfaction, agreement, or proof; "
632  +                     "a pure required operation belongs to OPERATION_BOUNDARY"
633  +                 )
634  +             required_terms = ("only", "required", "product")
635  +             if not all(term in continuation for term in required_terms) or not any(
636  +                 term in continuation for term in ("fail", "undecidable")
637  +             ):
638  +                 errors.append(
639  +                     f"{gate_id} PRODUCT continuation eligibility must say that only a failed/"
640  +                     "undecidable required product criterion permits continuation"
641  +                 )
642  +             if "only" not in blocking_scope:
643  +                 errors.append(f"{gate_id} PRODUCT blocking scope must be explicitly limited with 'only'")
644  +
645  +         if gate_class == "OPERATION_BOUNDARY":
646  +             if "only" not in blocking_scope or "never product" not in blocking_scope:
647  +                 errors.append(
648  +                     f"{gate_id} OPERATION_BOUNDARY blocking scope must say it holds only the "
649  +                     "exact operation and never product work/credit"
650  +                 )
651  +             if "no product loop" not in continuation:
652  +                 errors.append(f"{gate_id} OPERATION_BOUNDARY continuation must explicitly say 'No product loop'")
653  +             if any(
654  +                 token in failure_target
655  +                 for token in (
656  +                     "m02",
657  +                     "material repair",
658  +                     "material return",
659  +                     "product repair",
660  +                 )
661  +             ):
662  +                 errors.append(f"{gate_id} OPERATION_BOUNDARY failure target must not enter product repair")
663  +     return errors
