376  + INSTANCE_RE = re.compile(r"(?m)^###\s+(MI-[A-Z0-9][A-Z0-9_-]*)\s+-\s+(M\d{2}):\s+(.+?)\s*$")
377  + MI_RE = re.compile(r"\bMI-[A-Z0-9][A-Z0-9_-]*\b")
