752  + def validate(text: str, mapping_roles: set[str], mapping_name: str) -> list[str]:
753  +     errors: list[str] = []
754  +     title_matches = re.findall(r"(?m)^#\s+.+\s+-\s+Modular Execution Plan\s*$", text)
755  +     if len(title_matches) != 1:
756  +         errors.append(f"expected one modular execution plan title, found {len(title_matches)}")
757  +
758  +     positions: list[int] = []
759  +     for heading in HEADINGS:
760  +         count = text.count(heading)
761  +         if count != 1:
762  +             errors.append(f"expected one {heading!r}, found {count}")
763  +         else:
764  +             positions.append(text.index(heading))
765  +     if len(positions) == len(HEADINGS) and positions != sorted(positions):
766  +         errors.append("Sections 0-16 are out of order")
767  +     if errors:
768  +         return errors
769  +
770  +     unresolved = sorted(set(re.findall(r"\{\{[^}\n]+\}\}", text)))
771  +     if unresolved:
772  +         errors.append(f"unresolved template tokens remain: {', '.join(unresolved[:5])}")
773  +     if "TEMPLATE NOTE:" in text:
774  +         errors.append("TEMPLATE NOTE lines remain in the generated plan")
775  +     angle_placeholders = sorted(set(re.findall(r"<[^>\n]+>", text)))
776  +     if angle_placeholders:
777  +         errors.append(f"angle-bracket placeholders remain: {', '.join(angle_placeholders[:5])}")
778  +
779  +     by_section = sections(text)
780  +     errors.extend(validate_required_tables(by_section))
781  +     manifest_errors, instance_types = validate_module_manifest(by_section[HEADINGS[6]])
782  +     errors.extend(manifest_errors)
783  +     errors.extend(validate_instances(by_section[HEADINGS[11]], instance_types))
784  +     errors.extend(validate_policies(by_section[HEADINGS[9]]))
785  +     errors.extend(validate_gates(by_section[HEADINGS[8]]))
786  +     errors.extend(validate_cross_references(by_section, instance_types))
787  +     errors.extend(validate_roles(by_section[HEADINGS[7]], mapping_roles, mapping_name, text))
788  +     errors.extend(validate_rule_and_check_matrices(by_section))
789  +
790  +     local_instructions = by_section[HEADINGS[11]].lower()
791  +     for phrase in ("as needed", "if useful", "best practice"):
792  +         if phrase in local_instructions:
793  +             errors.append(f"module local instructions contain banned vague phrase: {phrase!r}")
794  +     return errors
