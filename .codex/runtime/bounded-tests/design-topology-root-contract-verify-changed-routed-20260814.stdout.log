541  + def validate_policies(body: str) -> list[str]:
542  +     errors: list[str] = []
543  +     found = re.findall(r"(?m)^###\s+P\d{2}.+?$", body)
544  +     if found != POLICY_HEADINGS:
545  +         errors.append("Section 9 does not contain exact P01-P15 policy headings in order")
546  +         return errors
547  +     for index, heading in enumerate(POLICY_HEADINGS):
548  +         start = body.index(heading) + len(heading)
549  +         end = body.index(POLICY_HEADINGS[index + 1], start) if index + 1 < len(POLICY_HEADINGS) else len(body)
550  +         policy_body = body[start:end]
551  +         rows = extract_table(policy_body, POLICY_TABLE)
552  +         if rows is None or not rows:
553  +             errors.append(f"{heading} has no populated policy table")
554  +         if heading.startswith("### P14"):
555  +             exception_rows = extract_table(policy_body, EXCEPTION_TABLE)
556  +             if exception_rows is None or not exception_rows:
557  +                 errors.append("P14 has no exception-class table or reasoned N/A row")
558  +     return errors
