453  +
454  + def validate_module_manifest(body: str) -> tuple[list[str], dict[str, str]]:
455  +     errors: list[str] = []
456  +     header = REQUIRED_TABLES[HEADINGS[6]][0]
457  +     rows = extract_table(body, header) or []
458  +     seen_modules = [row[0] for row in rows if len(row) == len(header)]
459  +     if duplicates(seen_modules):
460  +         errors.append(f"module manifest contains duplicates: {', '.join(duplicates(seen_modules))}")
461  +     missing = sorted(set(MODULE_IDS) - set(seen_modules))
462  +     extra = sorted(set(seen_modules) - set(MODULE_IDS))
463  +     if missing:
464  +         errors.append(f"module manifest is missing: {', '.join(missing)}")
465  +     if extra:
466  +         errors.append(f"module manifest has unknown module IDs: {', '.join(extra)}")
467  +
468  +     instance_types: dict[str, str] = {}
469  +     for row in rows:
470  +         if len(row) != len(header) or row[0] not in MODULE_IDS:
471  +             continue
472  +         module_id, decision, ids_cell = row[0], row[1].upper(), row[2]
473  +         if decision not in ALLOWED_MODULE_DECISIONS:
474  +             errors.append(f"{module_id} has invalid decision {row[1]!r}")
475  +             continue
476  +         instance_ids = MI_RE.findall(ids_cell)
477  +         if decision == "SELECTED" and not instance_ids:
478  +             errors.append(f"{module_id} is SELECTED but has no MI-* instance ID")
479  +         if decision != "SELECTED" and instance_ids:
480  +             errors.append(f"{module_id} is {decision} but declares instance IDs")
481  +         for instance_id in instance_ids:
482  +             if instance_id in instance_types:
483  +                 errors.append(f"module instance ID is declared more than once: {instance_id}")
484  +             instance_types[instance_id] = module_id
485  +     return errors, instance_types
