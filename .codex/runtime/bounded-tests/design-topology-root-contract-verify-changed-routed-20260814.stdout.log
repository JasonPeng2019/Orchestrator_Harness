702  + def validate_roles(body: str, mapping_roles: set[str], mapping_name: str, text: str) -> list[str]:
703  +     errors: list[str] = []
704  +     role_rows = extract_table(body, REQUIRED_TABLES[HEADINGS[7]][0]) or []
705  +     plan_roles = [row[0] for row in role_rows if len(row) == 8 and row[0] != "N/A"]
706  +     if not plan_roles:
707  +         errors.append("role table contains no workflow roles")
708  +     if duplicates(plan_roles):
709  +         errors.append(f"role table contains duplicate roles: {', '.join(duplicates(plan_roles))}")
710  +     if set(plan_roles) != mapping_roles:
711  +         missing = sorted(set(plan_roles) - mapping_roles)
712  +         extra = sorted(mapping_roles - set(plan_roles))
713  +         if missing:
714  +             errors.append(f"mapping is missing plan roles: {', '.join(missing)}")
715  +         if extra:
716  +             errors.append(f"mapping has roles absent from the plan: {', '.join(extra)}")
717  +     for row in role_rows:
718  +         if len(row) != 8 or row[0] == "N/A":
719  +             continue
720  +         pool_match = re.search(r"\b(\d+)\b", row[2])
721  +         if pool_match is None or int(pool_match.group(1)) < 1:
722  +             errors.append(f"role {row[0]} has no positive pool size")
723  +     if text.lower().count(mapping_name.lower()) != 1:
724  +         errors.append(f"plan must mention mapping filename {mapping_name!r} exactly once")
725  +     return errors
