380  + def normalize(value: str) -> str:
381  +     return re.sub(r"\s+", " ", value.strip().strip("`"))
382  +
383  +
384  + def table_cells(line: str) -> list[str] | None:
385  +     stripped = line.strip()
386  +     if not stripped.startswith("|") or not stripped.endswith("|"):
387  +         return None
388  +     return [normalize(cell) for cell in stripped[1:-1].split("|")]
389  +
390  +
391  + def is_separator(cells: list[str] | None) -> bool:
392  +     return bool(cells) and all(re.fullmatch(r":?-{3,}:?", cell) for cell in cells)
393  +
394  +
395  + def extract_table(body: str, header: tuple[str, ...]) -> list[list[str]] | None:
396  +     lines = body.splitlines()
397  +     expected = list(header)
398  +     for index, line in enumerate(lines):
399  +         if table_cells(line) != expected:
400  +             continue
401  +         if index + 1 >= len(lines) or not is_separator(table_cells(lines[index + 1])):
402  +             return []
403  +         rows: list[list[str]] = []
404  +         for row_line in lines[index + 2 :]:
405  +             cells = table_cells(row_line)
406  +             if cells is None:
407  +                 if rows or row_line.strip():
408  +                     break
409  +                 continue
410  +             if len(cells) != len(expected):
411  +                 rows.append(cells)
412  +                 continue
413  +             rows.append(cells)
414  +         return rows
415  +     return None
416  +
417  +
418  + def section(text: str, heading: str, next_heading: str | None) -> str:
419  +     start = text.index(heading) + len(heading)
420  +     end = text.index(next_heading, start) if next_heading else len(text)
421  +     return text[start:end]
422  +
423  +
424  + def sections(text: str) -> dict[str, str]:
425  +     return {
426  +         heading: section(text, heading, HEADINGS[index + 1] if index + 1 < len(HEADINGS) else None)
427  +         for index, heading in enumerate(HEADINGS)
428  +     }
429  +
430  +
431  + def duplicates(values: list[str]) -> list[str]:
432  +     return sorted(value for value, count in Counter(values).items() if count > 1)
433  +
434  +
435  + def id_column(rows: list[list[str]], pattern: str) -> list[str]:
436  +     return [row[0] for row in rows if row and re.fullmatch(pattern, row[0])]
437  +
438  +
439  + def validate_required_tables(by_section: dict[str, str]) -> list[str]:
440  +     errors: list[str] = []
441  +     for heading, headers in REQUIRED_TABLES.items():
442  +         body = by_section[heading]
443  +         for header in headers:
444  +             rows = extract_table(body, header)
445  +             if rows is None:
446  +                 errors.append(f"{heading} is missing table: {' | '.join(header)}")
447  +             elif not rows:
448  +                 errors.append(f"{heading} table has no data rows: {' | '.join(header)}")
449  +             elif any(len(row) != len(header) for row in rows):
450  +                 errors.append(f"{heading} table has a row with the wrong column count: {' | '.join(header)}")
451  +     return errors
