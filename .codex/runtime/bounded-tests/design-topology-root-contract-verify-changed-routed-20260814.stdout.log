666  + def validate_cross_references(by_section: dict[str, str], instance_types: dict[str, str]) -> list[str]:
667  +     errors: list[str] = []
668  +     req_header = REQUIRED_TABLES[HEADINGS[3]][0]
669  +     deliverable_header = REQUIRED_TABLES[HEADINGS[5]][0]
670  +     req_rows = extract_table(by_section[HEADINGS[3]], req_header) or []
671  +     deliverable_rows = extract_table(by_section[HEADINGS[5]], deliverable_header) or []
672  +     req_ids = id_column(req_rows, r"REQ-[A-Z0-9][A-Z0-9._-]*")
673  +     deliverable_ids = id_column(deliverable_rows, r"DEL-[A-Z0-9][A-Z0-9._-]*")
674  +     if not req_ids:
675  +         errors.append("requirement coverage map has no REQ-* rows")
676  +     if not deliverable_ids:
677  +         errors.append("deliverable model has no DEL-* rows")
678  +     if duplicates(req_ids):
679  +         errors.append(f"duplicate requirement IDs: {', '.join(duplicates(req_ids))}")
680  +     if duplicates(deliverable_ids):
681  +         errors.append(f"duplicate deliverable IDs: {', '.join(duplicates(deliverable_ids))}")
682  +     known_deliverables = set(deliverable_ids)
683  +     for row in req_rows:
684  +         if len(row) == len(req_header) and row[0].startswith("REQ-") and row[2] not in known_deliverables:
685  +             errors.append(f"{row[0]} references unknown deliverable {row[2]}")
686  +
687  +     capability_rows = extract_table(by_section[HEADINGS[4]], REQUIRED_TABLES[HEADINGS[4]][0]) or []
688  +     for row in capability_rows:
689  +         if len(row) == 7 and row[0] != "N/A" and row[1] not in ALLOWED_CAPABILITY_STATES:
690  +             errors.append(f"capability {row[0]!r} has invalid state {row[1]!r}")
691  +
692  +     selected_ids = set(instance_types)
693  +     for header in REQUIRED_TABLES[HEADINGS[8]]:
694  +         rows = extract_table(by_section[HEADINGS[8]], header) or []
695  +         for row in rows:
696  +             for instance_id in MI_RE.findall(" ".join(row)):
697  +                 if instance_id not in selected_ids:
698  +                     errors.append(f"Section 8 references undeclared module instance {instance_id}")
699  +     return errors
