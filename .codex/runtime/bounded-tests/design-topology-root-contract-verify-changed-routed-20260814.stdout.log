728  + def validate_rule_and_check_matrices(by_section: dict[str, str]) -> list[str]:
729  +     errors: list[str] = []
730  +     rule_rows = extract_table(by_section[HEADINGS[15]], REQUIRED_TABLES[HEADINGS[15]][0]) or []
731  +     rule_ids = [row[0] for row in rule_rows if len(row) == 3]
732  +     if rule_ids != RULE_IDS:
733  +         errors.append("Section 15 must map R1-R30 then S1-S16 exactly once and in order")
734  +
735  +     check_rows = extract_table(by_section[HEADINGS[16]], REQUIRED_TABLES[HEADINGS[16]][0]) or []
736  +     check_ids = [row[0] for row in check_rows if len(row) == 3]
737  +     if check_ids != CHECK_IDS:
738  +         errors.append("Section 16 must contain V01-V29 exactly once and in order")
739  +     for row in check_rows:
740  +         if len(row) == 3 and row[1] != "PASS":
741  +             errors.append(f"{row[0]} is not PASS")
742  +         if len(row) == 3 and not row[2].strip():
743  +             errors.append(f"{row[0]} has no basis")
744  +     marker_count = by_section[HEADINGS[16]].count("PLAN_STRUCTURE=VALID")
745  +     if marker_count != 1:
746  +         errors.append(f"expected one PLAN_STRUCTURE=VALID marker, found {marker_count}")
747  +     if "PLAN_STRUCTURE=INVALID" in by_section[HEADINGS[16]]:
748  +         errors.append("Section 16 still contains PLAN_STRUCTURE=INVALID")
749  +     return errors
