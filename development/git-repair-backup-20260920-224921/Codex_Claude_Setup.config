[core]
	repositoryformatversion = 0
	filemode = false
	bare = false
	logallrefupdates = true
	symlinks = false
	ignorecase = true
	worktree = ../../../Codex_Claude_Setup
[remote "origin"]
	url = https://github.com/JasonPeng2019/Codex_Claude_Setup.git
	fetch = +refs/heads/*:refs/remotes/origin/*
[branch "Generic"]
	remote = origin
	merge = refs/heads/Generic
	vscode-merge-base = origin/Generic
[branch "Multi-Agent"]
	remote = origin
	merge = refs/heads/Multi-Agent
	vscode-merge-base = origin/Multi-Agent
