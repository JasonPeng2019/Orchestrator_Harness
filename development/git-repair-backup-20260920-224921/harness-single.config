[core]
	repositoryformatversion = 0
	filemode = false
	bare = false
	logallrefupdates = true
	symlinks = false
	ignorecase = true
	worktree = ../../../harness-single
[remote "origin"]
	url = https://github.com/JasonPeng2019/harness-single.git
	fetch = +refs/heads/*:refs/remotes/origin/*
[branch "frozen-v1"]
	remote = origin
	merge = refs/heads/frozen-v1
	vscode-merge-base = origin/frozen-v1
[branch "main"]
	remote = origin
	merge = refs/heads/main
	vscode-merge-base = origin/main
[branch "working/memory-v1"]
	vscode-merge-base = origin/frozen-v1
