{
  "schema": "memory-harness-fixture-manifest/v1",
  "root": "development/test-tools/tests/fixtures",
  "control_child": "control_child.py",
  "control_child_modes": {
    "terminal": {
      "argv_template": ["python", "control_child.py", "terminal", "--exit-code", "<integer>"],
      "expected_exit_code": "<integer>",
      "stdout_json_keys": ["mode", "exit_code"]
    },
    "success": {
      "argv_template": ["python", "control_child.py", "success", "--checkpoint", "<path>", "--delay", "<seconds>"],
      "expected_exit_code": 0,
      "checkpoint_json": {"exit_code": 0, "mode": "success", "status": "complete"}
    },
    "record": {
      "argv_template": ["python", "control_child.py", "record", "--checkpoint", "<path>", "--delay", "<seconds>"],
      "expected_exit_code": 0,
      "initial_checkpoint_json": {"exit_code": null, "mode": "record", "status": "running"},
      "final_checkpoint_json": {"exit_code": 0, "mode": "record", "status": "complete"}
    },
    "owner": {
      "argv_template": ["python", "control_child.py", "owner", "--checkpoint", "<path>", "--linger-seconds", "<seconds>"],
      "expected_exit_code": 0,
      "record_json_keys": ["mode", "parent_pid", "descendant_pid", "status"],
      "internal_linger_mode": "linger"
    }
  },
  "qualification_commands": {
    "control_ready": {
      "command": "python -m unittest discover -s development/test-tools/tests -p test_fixture_controls.py",
      "cwd": "repository_root",
      "expected_exit_code": 0
    },
    "resolver_suite": {
      "command": "python -m unittest discover -s development/test-tools/tests -p test_resolve_role.py",
      "cwd": "repository_root",
      "expected_exit_code": 0
    },
    "ordinary_combined_discovery": {
      "command": "python -m unittest discover -s development/test-tools/tests -p test*.py",
      "cwd": "repository_root",
      "expected_exit_code": 0
    }
  },
  "task_bases": {
