      "no_cross_base_imports": true,
      "oracle": {
        "clamp": {
          "low_gt_high": {"arguments": [10, 20, 10], "raises": "ValueError"},
          "below_low": {"arguments": [1, 5, 10], "expected": 5},
          "interior": {"arguments": [7, 5, 10], "expected": 7},
          "low_endpoint": {"arguments": [5, 5, 10], "expected": 5},
          "high_endpoint": {"arguments": [10, 5, 10], "expected": 10},
          "above_high": {"arguments": [12, 5, 10], "expected": 10}
        },
        "parse_numbers": {
          "accepts": {"input": " 12 , -3 , 4 ", "expected": [12, -3, 4]},
          "rejects_empty": {"input": "", "raises": "ValueError"},
          "rejects_noninteger": {"input": "12,x", "raises": "ValueError"}
        },
        "parse_and_clamp": {
          "valid": {"input": "-2, 0, 5, 9", "low": 0, "high": 5, "expected": [0, 0, 5, 5]},
          "invalid_bounds": {"input": "1", "low": 5, "high": 0, "raises": "ValueError"},
          "invalid_tokens": {"input": "1,x", "low": 0, "high": 5, "raises": "ValueError"}
        }
      }
    }
