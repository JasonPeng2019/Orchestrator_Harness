      "path": "task_bases/routine",
      "required_files": ["clamp.py", "test_prerequisites.py", "test_task.py"],
      "prerequisite_command": ["python", "test_prerequisites.py"],
      "designated_task_command": ["python", "test_task.py"],
      "expected_prerequisite_exit": 0,
      "expected_designated_pre_task_exit": 1,
      "gap_id": "GAP-ROUTINE-ABOVE-HIGH",
      "gap_kind": "deliberate_defect",
      "prerequisite_excludes": ["above_high"],
      "self_contained": true,
      "no_cross_base_imports": true,
      "oracle": {
        "clamp": {
          "low_gt_high": {"arguments": [10, 20, 10], "raises": "ValueError"},
          "below_low": {"arguments": [1, 5, 10], "expected": 5},
          "interior": {"arguments": [7, 5, 10], "expected": 7},
          "low_endpoint": {"arguments": [5, 5, 10], "expected": 5},
          "high_endpoint": {"arguments": [10, 5, 10], "expected": 10},
          "above_high": {"arguments": [12, 5, 10], "expected": 10, "actual_pre_task": 12}
        }
      }
    },
    "middle": {
      "path": "task_bases/middle",
      "required_files": ["clamp.py", "test_prerequisites.py", "test_task.py"],
      "prerequisite_command": ["python", "test_prerequisites.py"],
      "designated_task_command": ["python", "test_task.py"],
      "expected_prerequisite_exit": 0,
      "expected_designated_pre_task_exit": 1,
      "gap_id": "GAP-MIDDLE-PARSE-NUMBERS",
      "gap_kind": "missing_implementation",
      "prerequisite_excludes": ["parse_numbers"],
      "self_contained": true,
      "no_cross_base_imports": true,
      "oracle": {
        "clamp": {
          "low_gt_high": {"arguments": [10, 20, 10], "raises": "ValueError"},
          "below_low": {"arguments": [1, 5, 10], "expected": 5},
          "interior": {"arguments": [7, 5, 10], "expected": 7},
          "low_endpoint": {"arguments": [5, 5, 10], "expected": 5},
          "high_endpoint": {"arguments": [10, 5, 10], "expected": 10},
          "above_high": {"arguments": [12, 5, 10], "expected": 10}
        },
        "parse_numbers": {
          "accepts": {"input": " 12 , -3 , 4 ", "expected": [12, -3, 4]},
          "rejects_empty": {"input": "", "raises": "ValueError"},
          "rejects_noninteger": {"input": "12,x", "raises": "ValueError"}
        }
      }
    },
    "heavy": {
      "path": "task_bases/heavy",
      "required_files": ["clamp.py", "parse_numbers.py", "test_prerequisites.py", "test_task.py"],
      "prerequisite_command": ["python", "test_prerequisites.py"],
      "designated_task_command": ["python", "test_task.py"],
      "expected_prerequisite_exit": 0,
      "expected_designated_pre_task_exit": 1,
      "gap_id": "GAP-HEAVY-PARSE-AND-CLAMP",
